# Public DNS names. Both must resolve to this deployment before startup.
SABEEL_DOMAIN=sabeel.example.com
SABEEL_AUTH_DOMAIN=auth.sabeel.example.com
ACME_EMAIL=operations@example.com

# Use independently generated values and store this file with mode 0600.
POSTGRES_PASSWORD=replace-with-a-long-random-password
ZITADEL_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
ZITADEL_MASTERKEY=CHANGE-ME-32-CHARACTER-MASTERKEY
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
SABEEL_OIDC_STATE_KEY=replace-with-at-least-32-random-characters

# Production email delivery for verification and recovery.
ZITADEL_SMTP_HOST=smtp.example.com:587
ZITADEL_SMTP_USER=replace-with-smtp-user
ZITADEL_SMTP_PASSWORD=replace-with-smtp-password
ZITADEL_SMTP_TLS=true
ZITADEL_SMTP_FROM=identity@sabeel.example.com
ZITADEL_SMTP_FROM_NAME=Sabeel Identity
ZITADEL_SMTP_REPLY_TO=support@sabeel.example.com

# Optional prebuilt images. Local builds are used when omitted.
SABEEL_API_IMAGE=sabeel:latest
SABEEL_FRONTEND_IMAGE=sabeel-frontend:latest

# Rotate these bootstrap PATs through Zitadel before these dates.
ZITADEL_ADMIN_PAT_EXPIRATION=2099-01-01T00:00:00Z
ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z
