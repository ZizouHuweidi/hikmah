# Sabeel uses the shared local Zitadel instance documented by Atlas and Trains.
SABEEL_OIDC_ISSUER=http://127.0.0.1:8081
SABEEL_OIDC_INTERNAL_URL=http://zitadel-dev-proxy:8080
SABEEL_OIDC_CLIENT_ID=
SABEEL_OIDC_CLIENT_SECRET=
SABEEL_OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
SABEEL_OIDC_STATE_KEY=sabeel-development-oidc-state-key-change-me
SABEEL_PUBLIC_URL=http://localhost:3000
SABEEL_SESSION_SECURE=false
